# Environment variables required for local Terraform development.
#
# Copy this file to `.env` and fill in the values. If you have mise
# installed (https://mise.jdx.dev), it will load `.env` automatically
# when you `cd` into the repo. Otherwise, source it manually:
#   set -a && source .env && set +a
#
# DO NOT commit a populated .env file. It is gitignored on purpose.

# --- AWS credentials (sensitive) ---
# IAM user/SSO credentials with permissions to manage S3, CloudFront,
# Route 53 and ACM in the target account.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Terraform Cloud token (sensitive) ---
# Personal API token used to authenticate against the Terraform Cloud
# remote backend. Generate one at:
#   https://app.terraform.io/app/settings/tokens
# The remote workspace is `waldoibarra-com` in the `waldo-io` org:
#   https://app.terraform.io/app/waldo-io/workspaces/waldoibarra-com
TF_TOKEN_app_terraform_io=

# --- Terraform input variables (non-sensitive) ---
# Domain name the website is served under. Must match an existing
# Route 53 hosted zone you own.
TF_VAR_domain_name=waldoibarra.com

# Route 53 hosted zone ID for the domain above. Find it in the AWS
# console under Route 53 > Hosted zones, or via:
#   aws route53 list-hosted-zones-by-name --dns-name waldoibarra.com.
TF_VAR_hosted_zone_id=

# Local AWS named profile used by the Terraform module's aws CLI
# invocation. The CI pipeline sets this to `default`; locally, you
# can use any profile name as long as it is configured in your
# ~/.aws/credentials or ~/.aws/config file.
TF_VAR_aws_profile=default

# Tag value applied to all AWS resources created by the module. Helps
# identify ownership in billing / resource explorer.
TF_VAR_Application="Personal static website"
